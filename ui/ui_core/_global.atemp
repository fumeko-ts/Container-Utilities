{  
  "namespace": "_global",

  "redstone_content": {
    "type": "panel",
    "controls": [
      { "right_elements@toggle_manager.primary_management_toggles": {"$toggle_position": "right"} },
      { "text_box@_global.text_edit_control": {} }
    ]
  },
  "input_panel_with_index@_global.input_panel_overlay": {
    "size": ["100%", 18],
    "collection_index": "($collection_index + $row_index_offset)",
    "$button_output_action": "$output_action",
    "bindings": [
      {
        "binding_type": "collection_details",
        "binding_collection_name": "$item_collection_name",
        "binding_condition": "once"
      },
      {
        "binding_type": "collection",
        "binding_collection_name": "$item_collection_name",
        "binding_name": "#hover_text"
      },
      {
        "binding_type": "view",
        "source_control_name": "utility_search_box",
        "source_property_name": "#item_name",
        "target_property_name": "#item_name"
      },
      {
        "binding_type": "view",
        "source_property_name": "((#item_name = '') or (not ((#hover_text - #item_name) = #hover_text)))",
        "target_property_name": "#visible"
      }
    ]
  },
  "text_edit_control@common.text_edit_box": {
    "property_bag": {
      "#property_field": "#item_name"
    },
    "anchor_from": "bottom_middle",
    "anchor_to": "top_middle",
    "offset": [0, 2],
    "$text_edit_text_control": "utility_search_box",
    "size": ["100%", 18],
    "max_length": 30,
    "$text_edit_binding_name": "#text_box_item_name",
    "$text_edit_box_label_size": ["default", 10]
  },
  "input_panel_overlay": {
    "type": "input_panel",

    "layer": 200,
    "bindings": [
      {
        "binding_type": "collection_details",
        "binding_collection_name": "$item_collection_name",
        "binding_condition": "once"
      }
    ],
    "always_listen_to_input": true,
    "consume_hover_events": false,
    "$button_output_action|default": "",
    "button_mappings": [
      {
        "from_button_id": "button.menu_select",
        "to_button_id": "$button_output_action",
        "consume_event": false,
        "mapping_type": "pressed"
      },
      {
        "from_button_id": "button.menu_secondary_select",
        "to_button_id": "$button_output_action",
        "consume_event": false,
        "mapping_type": "pressed"
      },
      {
        "from_button_id": "button.menu_ok",
        "to_button_id": "$button_output_action",
        "consume_event": false,
        "mapping_type": "pressed"
      },
      {
        "from_button_id": "button.controller_select",
        "to_button_id": "$button_output_action",
        "consume_event": false,
        "mapping_type": "pressed"
      },
      {
        "from_button_id": "button.controller_secondary_select",
        "to_button_id": "$button_output_action",
        "consume_event": false,
        "mapping_type": "pressed"
      },

      {
        "from_button_id": "button.inventory_left",
        "to_button_id": "$button_output_action",
        "ignored": "(not $mouse)",
        "consume_event": false,
        "mapping_type": "pressed"
      },
      {
        "from_button_id": "button.inventory_right",
        "to_button_id": "$button_output_action",
        "ignored": "(not $mouse)",
        "consume_event": false,
        "mapping_type": "pressed"
      }
    ]
  },
  "button": {
    "type": "button",
    "bindings": [
      {
        "binding_type": "collection_details",
        "binding_collection_name": "$item_collection_name",
        "binding_condition": "once"
      }
    ],
    "controls": [{ "highlight@$hover_control": {} }],
    "hover_control": "highlight",
    "sound_name": "random.click",
    "sound_volume": 0,
    "sound_pitch": 0,
    "default_focus_precedence": 1,
    "$button_output_action|default": "",
    "button_mappings": [
      {
        "from_button_id": "button.menu_select",
        "to_button_id": "$button_output_action",
        "consume_event": false,
        "mapping_type": "pressed"
      },
      {
        "from_button_id": "button.menu_secondary_select",
        "to_button_id": "$button_output_action",
        "consume_event": false,
        "mapping_type": "pressed"
      },
      {
        "from_button_id": "button.menu_ok",
        "to_button_id": "$button_output_action",
        "consume_event": false,
        "mapping_type": "pressed"
      },
      {
        "from_button_id": "button.controller_select",
        "to_button_id": "$button_output_action",
        "consume_event": false,
        "mapping_type": "pressed"
      },
      {
        "from_button_id": "button.controller_secondary_select",
        "to_button_id": "$button_output_action",
        "consume_event": false,
        "mapping_type": "pressed"
      },

      {
        "from_button_id": "button.inventory_left",
        "to_button_id": "$button_output_action",
        "ignored": "(not $mouse)",
        "consume_event": false,
        "mapping_type": "pressed"
      },
      {
        "from_button_id": "button.inventory_right",
        "to_button_id": "$button_output_action",
        "ignored": "(not $mouse)",
        "consume_event": false,
        "mapping_type": "pressed"
      }
    ]
  },

  "toggle": {
    "type": "panel",
    "$radio_toggle_group|default": false,
    "$toggle_default_state|default": false,
    "$toggle_group_forced_index|default": -1,
    "$toggle_group_default_selected|default": 0,
    "controls": [
      {
        "$toggle_view_binding_name": {
          "type": "toggle",

          "layer": 2,
          "sound_name": "random.click",
          "sound_volume": 0,
          "sound_pitch": 0,
          "radio_toggle_group": "$radio_toggle_group",
          "toggle_name": "$toggle_name",
          "toggle_default_state": "$toggle_default_state",
          "toggle_group_forced_index": "$toggle_group_forced_index",
          "toggle_group_default_selected": "$toggle_group_default_selected",
          "consume_hover_events": false,
          "always_listen_to_input": true,
          "button_mappings": [
            {
              "from_button_id": "button.menu_select",
              "to_button_id": "button.menu_ok",
              "consume_event": false,
              "mapping_type": "pressed"
            },
            {
              "from_button_id": "button.menu_secondary_select",
              "to_button_id": "button.menu_ok",
              "consume_event": false,
              "mapping_type": "pressed"
            },
            {
              "from_button_id": "button.menu_ok",
              "to_button_id": "button.menu_ok",
              "consume_event": false,
              "mapping_type": "pressed"
            },
            {
              "from_button_id": "button.controller_select",
              "to_button_id": "button.menu_ok",
              "consume_event": false,
              "mapping_type": "pressed"
            },
            {
              "from_button_id": "button.controller_secondary_select",
              "to_button_id": "button.menu_ok",
              "consume_event": false,
              "mapping_type": "pressed"
            },
            {
              "from_button_id": "button.inventory_left",
              "to_button_id": "button.menu_ok",
              "consume_event": false,
              "ignored": "(not $mouse)",
              "mapping_type": "pressed"
            },
            {
              "from_button_id": "button.inventory_right",
              "to_button_id": "button.menu_ok",
              "consume_event": false,
              "ignored": "(not $mouse)",
              "mapping_type": "pressed"
            }
          ],
          "property_bag": { "#toggle_state": true },
          "bindings": [
            {
              "binding_type": "global",
              "binding_condition": "always",
              "binding_name": "('#mode_' + $toggle_view_binding_name)",
              "binding_name_override": "#toggle_state"
            }
          ],
          "controls": [
            {
              "toggle_label_underlay": {
                "type": "image",
                "layer": 1,
                "size": ["100%c + 7px", "100% - 4px"],

                "texture": "$toggle_label_underlay_texture",
                "nineslice_size": "$toggle_label_underlay_texture_nineslice",
                "uv": "$toggle_label_underlay_uv",
                "uv_size": "$toggle_label_underlay_uv_size",

                "anchor_from": "$toggle_holder_anchor_from",
                "anchor_to": "$toggle_holder_anchor_to",

                "offset": "$toggle_label_underlay_offset",

                "controls": [
                  {
                    "toggle_label": {
                      "type": "label",
                      "size": ["default", 10],
                      "layer": 5,
                      "offset": [1, 0],
                      "anchor_from": "center",
                      "anchor_to": "center",
                      "color": "$toggle_label_color",
                      "text": "('#' + $toggle_view_binding_name)",
                      "property_bag": {
                        "#move_one": "x1",
                        "#move_two": "x2",
                        "#move_all": "x64",
                        "#drop_one": "x1",
                        "#drop_all": "x64",
                        "#toggle_mode_reset": "structure_block.reset",

                        //row text
                        "#move_one_row": "x1",
                        "#move_two_row": "x2",
                        "#move_all_row": "x64",
                        "#drop_all_row": "x64"
                      }
                    }
                  }
                ]
              }
            }
          ]
        }
      }
    ]
  },
  "radio@_global.toggle": {
    "size": "$management_toggle_size",
    "$radio_toggle_group": true,
    "$toggle_name": "item_management_toggles",
    "$toggle_group_forced_index": 0,
    "$toggle_group_default_selected": 0
  },

  "button_visuals": {
    "type": "button",
    "layer": 1,
    "size": ["100%", "100%"],
    "default_control": "default",
    "pressed_control": "pressed",
    "hover_control": "hover",
    "sound_name": "random.click",
    "sound_volume": 1,
    "sound_pitch": 1,
    "$toggle_is_hover|default": true,
    "$icon_path|default": "$icon_reset_texture",
    "controls": [
      {
        "default@_global.toggle_texture_template": {
          "texture": "$button_default_texture",
          "$toggle_is_hover": false
        }
      },
      { "hover@_global.toggle_texture_template": { "texture": "$button_hover_texture" } },
      { "pressed@_global.toggle_texture_template": { "texture": "$button_pressed_texture" } }
    ],

    "button_mappings": [
      {
        "from_button_id": "button.menu_select",
        "to_button_id": "button.menu_ok",
        "mapping_type": "pressed"
      },
      {
        "from_button_id": "button.menu_secondary_select",
        "to_button_id": "button.menu_ok",
        "mapping_type": "pressed"
      },
      {
        "from_button_id": "button.menu_ok",
        "to_button_id": "button.menu_ok",
        "mapping_type": "pressed"
      },
      {
        "from_button_id": "button.controller_select",
        "to_button_id": "button.menu_ok",
        "mapping_type": "pressed"
      },
      {
        "from_button_id": "button.controller_secondary_select",
        "to_button_id": "button.menu_ok",
        "mapping_type": "pressed"
      },

      {
        "from_button_id": "button.inventory_left",
        "to_button_id": "button.menu_ok",
        "ignored": "(not $mouse)",
        "mapping_type": "pressed"
      },
      {
        "from_button_id": "button.inventory_right",
        "to_button_id": "button.menu_ok",
        "ignored": "(not $mouse)",
        "mapping_type": "pressed"
      }
    ]
  },

  "toggle_texture_template": {
    "type": "image",
    "nineslice_size": "$button_texture_nineslice",
    "anchor_from": "center",
    "anchor_to": "center",
    "layer": 3,
    "size": ["100% - 2px", "100% - 2px"],
    "controls": [
      {
        "$icon_path": {
          "type": "image",
          "size": "$icon_image_size",
          "texture": "$icon_path",
          "color": "$icon_color",
          "layer": 4,
          "offset": "$icon_texture_offset",
          "anchor_from": "center",
          "anchor_to": "center",
          "$icon_image_size": "$icon_texture_size",
          "variables": {
            "requires": "($icon_path = $icon_reset_texture)",
            "$icon_image_size": "$icon_texture_reset_size"
          }
        }
      }
    ],
    "$icon_color|default": "$icon_texture_default_color",
    "variables": {
      "requires": "$toggle_is_hover",
      "$icon_color": "$icon_texture_hover_color"
    }
  }
}
