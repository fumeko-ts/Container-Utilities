{  
  "namespace": "item_data",

  "item_movement_factory": {
    "type": "panel",
    "size": ["100%", "100%"],
    "layer": 5,
    "$hover_control|default": "common.highlight_slot_panel",
    "controls": [
      {
        "vanilla_button": {
          "type": "panel",
          "size": ["100%", "100%"],
          "controls": [
            {
              "item_button_ref@$button_ref": {}
            }
          ],
          "bindings": [
            {
              "binding_type": "view",
              "source_control_name": "toggle_mode_reset",
              "source_property_name": "#toggle_state",
              "target_property_name": "#visible"
            }
          ]
        }
      },
      { "1@item_data.input_area_template": { "$movement_action_control": "item_data.move_one" } },
      { "2@item_data.input_area_template": { "$movement_action_control": "item_data.move_two" } },
      { "3@item_data.input_area_template": { "$movement_action_control": "item_data.move_all" } },
      { "4@item_data.input_area_template": { "$movement_action_control": "item_data.drop_one" } },
      { "5@item_data.input_area_template": { "$movement_action_control": "item_data.drop_all" } }
    ]
  },

  "input_area_template": {
    "type": "panel",
    "$movement_action_control|default": "",
    "controls": [{ "$movement_action_control@$movement_action_control": {} }],
    "bindings": [
      {
        "binding_type": "view",
        "source_control_name": "($movement_action_control - 'item_data.')",
        "source_property_name": "#toggle_state",
        "target_property_name": "#visible"
      }
    ]
  },

  "move_one@_global.button": { "$button_output_action": "button.container_auto_place_one" },
  "move_two": {
    "type": "panel",
    "controls": [
      { "drop_button_underlay@item_data.move_one": {} },
      { "move_2_overlay@_global.input_panel_overlay": { "$button_output_action": "button.container_auto_place_one" } }
    ]
  },
  "move_all@_global.button": { "$button_output_action": "button.container_auto_place" },
  "drop_one@_global.button": { "$button_output_action": "button.drop_one" },
  "drop_all@_global.button": { "$button_output_action": "button.drop_all" }
}
