{
  "namespace": "item_data",

  "item_movement_factory": {
    "type": "panel",
    "size": ["100%", "100%"],
    "layer": 5,
    "$hover_control|default": "common.highlight_slot_panel",
    "$button_factory_variables|default": [
      //if your trying to accses a variable from above wilst inside the factory
      //you will need to define it inside this array like "$hover_control"
      "$item_collection_name",
      "$hover_control"
    ],
    "controls": [
      {
        "vanilla_button": {
          "type": "panel",
          "size": ["100%", "100%"],
          "controls": [
            {
              "item_button_ref@$button_ref": {}
            }
          ],
          "bindings": [
            {
              "binding_type": "view",
              "resolve_sibling_scope": true,
              "source_control_name": "vanilla_button_replacement",
              "source_property_name": "(#toggle_length = 0)",
              "target_property_name": "#visible"
            }
          ]
        }
      },
      {
        "vanilla_button_replacement": {
          "type": "collection_panel",
          "collection_name": "item_movement_collection",
          "size": ["100%", "100%"],
          "factory": {
            "name": "item_movement_buttons_factory",
            "control_ids": {
              "move_1": "item_data.move_1",
              "move_all": "item_data.move_all",
              "drop_1": "item_data.drop_1",
              "drop_all": "item_data.drop_all",
              "move_2": "item_data.move_2"
            },
            "factory_variables": "$button_factory_variables"
          },
          "property_bag": {
            "#button_index_1": ["move_1"],
            "#button_index_2": ["move_2"],
            "#button_index_3": ["move_all"],
            "#button_index_4": ["drop_1"],
            "#button_index_5": ["drop_all"]
          },
          "bindings": [
            {"binding_type":"view","source_control_name":"move_one","source_property_name":"(#toggle_state * 1)","target_property_name":"#p1"},
            {"binding_type":"view","source_control_name":"move_two","source_property_name":"(#toggle_state * 2)","target_property_name":"#p2"},
            {"binding_type":"view","source_control_name":"move_all","source_property_name":"(#toggle_state * 3)","target_property_name":"#p3"},
            {"binding_type":"view","source_control_name":"drop_one","source_property_name":"(#toggle_state * 4)","target_property_name":"#p4"},
            {"binding_type":"view","source_control_name":"drop_all","source_property_name":"(#toggle_state * 5)","target_property_name":"#p5"},
            {
              "binding_type": "view",
              "source_property_name": "(#p1 + #p2 + #p3 + #p4 + #p5)",
              "target_property_name": "#toggle_length"
            },
            {
              "binding_type": "view",
              "source_property_name": "('#button_index_' + #toggle_length)",
              "target_property_name": "#collection_length"
            }
          ]
        }
      }
    ]
  },



  "move_1@_global.button": {"$button_output_action": "button.container_auto_place_one"},
  "move_2": {
    "type": "panel",
    "controls": [
      {"drop_button_underlay@item_data.move_1": {}},
      {"move_2_overlay@_global.input_panel_overlay": {"$button_output_action": "button.container_auto_place_one"}}
    ]
  },
  "move_all@_global.button": {"$button_output_action": "button.container_auto_place"},
  "drop_1@_global.button"  : {"$button_output_action": "button.drop_one"},
  "drop_all@_global.button": {"$button_output_action": "button.drop_all"}
}
